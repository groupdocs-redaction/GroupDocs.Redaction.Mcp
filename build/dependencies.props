<Project>

  <PropertyGroup Label="SDK Versions">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Label="Reproducible build">
    <Deterministic>true</Deterministic>
    <!-- Normalizes paths inside .pdb/.dll on CI for reproducible output -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Package information">
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/groupdocs-redaction/GroupDocs.Redaction.Mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/groupdocs-redaction/GroupDocs.Redaction.Mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>GroupDocs Contributors</Authors>
    <Company>Aspose</Company>
    <Copyright>Copyright © Aspose Pty Ltd $([System.DateTime]::Now.Year)</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>true</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <PropertyGroup Label="Package Versions">
    <GroupDocsRedactionMcp>26.7.0</GroupDocsRedactionMcp>
  </PropertyGroup>

  <PropertyGroup Label="External Dependency Versions">
    <GroupDocsMcpCore>26.4.1</GroupDocsMcpCore>
    <GroupDocsRedaction>26.6.0</GroupDocsRedaction>
    <MicrosoftExtensionsHosting>10.0.5</MicrosoftExtensionsHosting>
    <ModelContextProtocol>1.1.0</ModelContextProtocol>
    <MicrosoftSourceLinkGithub>8.0.0</MicrosoftSourceLinkGithub>
    <!-- Must match the SkiaSharp version $(GroupDocsRedaction) transitively pulls. GroupDocs.Redaction 26.6.0 (via GroupDocs.Redaction.Net100) declares SkiaSharp 3.119.1. Re-verify after every GroupDocsRedaction bump (ABI-incompatible otherwise). -->
    <SkiaSharp>3.119.1</SkiaSharp>
  </PropertyGroup>

  <PropertyGroup Label="NuGet Common Settings">
    <PackageReleaseNotes>https://github.com/groupdocs-redaction/GroupDocs.Redaction.Mcp/releases/tag/$(GroupDocsRedactionMcp)</PackageReleaseNotes>
  </PropertyGroup>

</Project>
